{
  "service": {
    "name": "peekview-api",
    "version": "0.14.0",
    "port": 8080,
    "debug": false,
    "features": [
      "auth",
      "sharing",
      "search",
      "metrics",
      "rate_limit"
    ],
    "database": {
      "engine": "sqlite",
      "path": "/data/peekview.db",
      "wal_mode": true,
      "busy_timeout": 5,
      "pool_size": 10,
      "timeout": 30.5,
      "replicas": []
    },
    "cache": {
      "type": "memory",
      "ttl_seconds": 3600,
      "max_entries": 5000,
      "eviction_policy": "lru"
    },
    "endpoints": [
      {
        "path": "/api/v1/entries",
        "method": "GET",
        "auth": true,
        "rate_limit": 60
      },
      {
        "path": "/api/v1/entries",
        "method": "POST",
        "auth": true,
        "rate_limit": 10
      },
      {
        "path": "/api/v1/entries/{slug}",
        "method": "GET",
        "auth": false
      },
      {
        "path": "/api/v1/entries/{slug}/raw",
        "method": "GET",
        "auth": false
      },
      {
        "path": "/api/v1/auth/login",
        "method": "POST",
        "auth": false
      },
      {
        "path": "/api/v1/auth/register",
        "method": "POST",
        "auth": false
      },
      {
        "path": "/api/v1/admin/stats",
        "method": "GET",
        "auth": true,
        "admin": true
      }
    ],
    "logging": {
      "level": "INFO",
      "format": "%(asctime)s [%(levelname)s] %(name)s: %(message)s",
      "outputs": [
        "stdout",
        "file"
      ],
      "file_path": "/var/log/peekview/app.log",
      "rotation": {
        "max_bytes": 10485760,
        "backup_count": 5
      }
    },
    "rate_limit": {
      "enabled": true,
      "requests_per_minute": 60,
      "burst": 10,
      "strategy": "token_bucket"
    },
    "null_field": null,
    "boolean_flags": {
      "cors_enabled": true,
      "compression": true,
      "swagger_ui": false,
      "prometheus_metrics": true
    },
    "security": {
      "jwt": {
        "algorithm": "HS256",
        "expiry_minutes": 1440,
        "refresh_enabled": true,
        "refresh_expiry_days": 30
      },
      "password": {
        "min_length": 8,
        "bcrypt_rounds": 12
      },
      "api_key": {
        "prefix": "pv_",
        "max_per_user": 10,
        "hash_algorithm": "sha256"
      },
      "csp": {
        "default_src": [
          "self"
        ],
        "script_src": [
          "self",
          "unsafe-eval"
        ],
        "style_src": [
          "self",
          "unsafe-inline"
        ]
      }
    }
  },
  "frontend": {
    "framework": "vue3",
    "build_tool": "vite",
    "typescript": true,
    "code_highlight": "shiki",
    "diagram_renderers": [
      "mermaid",
      "plantuml"
    ],
    "structured_viewers": {
      "csv": "TableView",
      "tsv": "TableView",
      "json": "TreeView",
      "yaml": "TreeView",
      "xml": "TreeView"
    },
    "theme": {
      "default": "dark",
      "toggle": true,
      "persist": true
    }
  },
  "mcp_server": {
    "version": "0.10.0",
    "transport": "streamable_http",
    "modes": [
      "remote",
      "local"
    ],
    "tools": {
      "remote": [
        "create_entry",
        "get_entry",
        "list_entries",
        "delete_entry"
      ],
      "local": [
        "publish_files",
        "get_entry",
        "list_entries",
        "delete_entry"
      ]
    }
  }
}
